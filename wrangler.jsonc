{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "healingmart-exam-cloudflare",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "healingmart-exam-cloudflare",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
